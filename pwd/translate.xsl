>
  <x:template match="pwd:trans">
    <x:if test="not(preceding-sibling::*[substring-before(name(), ':') = $lang]) and not(following-sibling::*[substring-before(name(), ':') = $lang])">
      <x:apply-templates />
    </x:if>
  </x:template>

  <x:template match="aa:trans|ab:trans|ae:trans|af:trans|ak:trans|am:trans|an:trans|ar:trans|as:trans|av:trans|ay:trans|az:trans|ba:trans|be:trans|bg:trans|bi:trans|bm:trans|bn:trans|bo:trans|br:trans|bs:trans|ca:trans|ce:trans|ch:trans|co:trans|cr:trans|cs:trans|cu:trans|cv:trans|cy:trans|da:trans|de:trans|dv:trans|dz:trans|ee:trans|el:trans|en:trans|eo:trans|es:trans|et:trans|eu:trans|fa:trans|ff:trans|fi:trans|fj:trans|fo:trans|fr:trans|fy:trans|ga:trans|gd:trans|gl:trans|gn:trans|gu:trans|gv:trans|ha:trans|he:trans|hi:trans|ho:trans|hr:trans|ht:trans|hu:trans|hy:trans|hz:trans|ia:trans|id:trans|ie:trans|ig:trans|ii:trans|ik:trans|io:trans|is:trans|it:trans|iu:trans|ja:trans|jv:trans|ka:trans|kg:trans|ki:trans|kj:trans|kk:trans|kl:trans|km:trans|kn:trans|ko:trans|kr:trans|ks:trans|ku:trans|kv:trans|kw:trans|ky:trans|la:trans|lb:trans|lg:trans|li:trans|ln:trans|lo:trans|lt:trans|lu:trans|lv:trans|mg:trans|mh:trans|mi:trans|mk:trans|ml:trans|mn:trans|mr:trans|ms:trans|mt:trans|my:trans|na:trans|nb:trans|nd:trans|ne:trans|ng:trans|nl:trans|nn:trans|no:trans|nr:trans|nv:trans|ny:trans|oc:trans|oj:trans|om:trans|or:trans|os:trans|pa:trans|pi:trans|pl:trans|ps:trans|pt:trans|qu:trans|rm:trans|rn:trans|ro:trans|ru:trans|rw:trans|sa:trans|sc:trans|sd:trans|se:trans|sg:trans|si:trans|sk:trans|sl:trans|sm:trans|sn:trans|so:trans|sq:trans|sr:trans|ss:trans|st:trans|su:trans|sv:trans|sw:trans|ta:trans|te:trans|tg:trans|th:trans|ti:trans|tk:trans|tl:trans|tn:trans|to:trans|tr:trans|ts:trans|tt:trans|tw:trans|ty:trans|ug:trans|uk:trans|ur:trans|uz:trans|ve:trans|vi:trans|vo:trans|wa:trans|wo:trans|xh:trans|yi:trans|yo:trans|za:trans|zh:trans|zu:trans">
    <x:variable name="prefix" select="substring-before(name(), ':')" />
    <x:if test="$lang = $prefix">
      <x:apply-templates />
    </x:if>
  </x:template>

  <x:template match="@aa:*|@ab:*|@ae:*|@af:*|@ak:*|@am:*|@an:*|@ar:*|@as:*|@av:*|@ay:*|@az:*|@ba:*|@be:*|@bg:*|@bi:*|@bm:*|@bn:*|@bo:*|@br:*|@bs:*|@ca:*|@ce:*|@ch:*|@co:*|@cr:*|@cs:*|@cu:*|@cv:*|@cy:*|@da:*|@de:*|@dv:*|@dz:*|@ee:*|@el:*|@en:*|@eo:*|@es:*|@et:*|@eu:*|@fa:*|@ff:*|@fi:*|@fj:*|@fo:*|@fr:*|@fy:*|@ga:*|@gd:*|@gl:*|@gn:*|@gu:*|@gv:*|@ha:*|@he:*|@hi:*|@ho:*|@hr:*|@ht:*|@hu:*|@hy:*|@hz:*|@ia:*|@id:*|@ie:*|@ig:*|@ii:*|@ik:*|@io:*|@is:*|@it:*|@iu:*|@ja:*|@jv:*|@ka:*|@kg:*|@ki:*|@kj:*|@kk:*|@kl:*|@km:*|@kn:*|@ko:*|@kr:*|@ks:*|@ku:*|@kv:*|@kw:*|@ky:*|@la:*|@lb:*|@lg:*|@li:*|@ln:*|@lo:*|@lt:*|@lu:*|@lv:*|@mg:*|@mh:*|@mi:*|@mk:*|@ml:*|@mn:*|@mr:*|@ms:*|@mt:*|@my:*|@na:*|@nb:*|@nd:*|@ne:*|@ng:*|@nl:*|@nn:*|@no:*|@nr:*|@nv:*|@ny:*|@oc:*|@oj:*|@om:*|@or:*|@os:*|@pa:*|@pi:*|@pl:*|@ps:*|@pt:*|@qu:*|@rm:*|@rn:*|@ro:*|@ru:*|@rw:*|@sa:*|@sc:*|@sd:*|@se:*|@sg:*|@si:*|@sk:*|@sl:*|@sm:*|@sn:*|@so:*|@sq:*|@sr:*|@ss:*|@st:*|@su:*|@sv:*|@sw:*|@ta:*|@te:*|@tg:*|@th:*|@ti:*|@tk:*|@tl:*|@tn:*|@to:*|@tr:*|@ts:*|@tt:*|@tw:*|@ty:*|@ug:*|@uk:*|@ur:*|@uz:*|@ve:*|@vi:*|@vo:*|@wa:*|@wo:*|@xh:*|@yi:*|@yo:*|@za:*|@zh:*|@zu:*">
    <x:variable name="prefix" select="substring-before(name(), ':')" />
    <x:if test="$lang = $prefix and local-name() != 'path'">
      <x:attribute name="{local-name()}">
        <x:value-of select="." />
      </x:attribute>
    </x:if>
  </x:template>

  <x:template match="pwd:lang-alternates">
    <x:message>
      <x:text>Transforming lang-alternates element</x:text>
    </x:message>

    <x:variable name="canonical-url" select="@canonical-url" />

    <x:for-each select="//@aa:path|//@ab:path|//@ae:path|//@af:path|//@ak:path|//@am:path|//@an:path|//@ar:path|//@as:path|//@av:path|//@ay:path|//@az:path|//@ba:path|//@be:path|//@bg:path|//@bi:path|//@bm:path|//@bn:path|//@bo:path|//@br:path|//@bs:path|//@ca:path|//@ce:path|//@ch:path|//@co:path|//@cr:path|//@cs:path|//@cu:path|//@cv:path|//@cy:path|//@da:path|//@de:path|//@dv:path|//@dz:path|//@ee:path|//@el:path|//@en:path|//@eo:path|//@es:path|//@et:path|//@eu:path|//@fa:path|//@ff:path|//@fi:path|//@fj:path|//@fo:path|//@fr:path|//@fy:path|//@ga:path|//@gd:path|//@gl:path|//@gn:path|//@gu:path|//@gv:path|//@ha:path|//@he:path|//@hi:path|//@ho:path|//@hr:path|//@ht:path|//@hu:path|//@hy:path|//@hz:path|//@ia:path|//@id:path|//@ie:path|//@ig:path|//@ii:path|//@ik:path|//@io:path|//@is:path|//@it:path|//@iu:path|//@ja:path|//@jv:path|//@ka:path|//@kg:path|//@ki:path|//@kj:path|//@kk:path|//@kl:path|//@km:path|//@kn:path|//@ko:path|//@kr:path|//@ks:path|//@ku:path|//@kv:path|//@kw:path|//@ky:path|//@la:path|//@lb:path|//@lg:path|//@li:path|//@ln:path|//@lo:path|//@lt:path|//@lu:path|//@lv:path|//@mg:path|//@mh:path|//@mi:path|//@mk:path|//@ml:path|//@mn:path|//@mr:path|//@ms:path|//@mt:path|//@my:path|//@na:path|//@nb:path|//@nd:path|//@ne:path|//@ng:path|//@nl:path|//@nn:path|//@no:path|//@nr:path|//@nv:path|//@ny:path|//@oc:path|//@oj:path|//@om:path|//@or:path|//@os:path|//@pa:path|//@pi:path|//@pl:path|//@ps:path|//@pt:path|//@qu:path|//@rm:path|//@rn:path|//@ro:path|//@ru:path|//@rw:path|//@sa:path|//@sc:path|//@sd:path|//@se:path|//@sg:path|//@si:path|//@sk:path|//@sl:path|//@sm:path|//@sn:path|//@so:path|//@sq:path|//@sr:path|//@ss:path|//@st:path|//@su:path|//@sv:path|//@sw:path|//@ta:path|//@te:path|//@tg:path|//@th:path|//@ti:path|//@tk:path|//@tl:path|//@tn:path|//@to:path|//@tr:path|//@ts:path|//@tt:path|//@tw:path|//@ty:path|//@ug:path|//@uk:path|//@ur:path|//@uz:path|//@ve:path|//@vi:path|//@vo:path|//@wa:path|//@wo:path|//@xh:path|//@yi:path|//@yo:path|//@za:path|//@zh:path|//@zu:path">
      <x:variable name="prefix" select="substring-before(name(), ':')" />
      <link rel="alternate" href="{$canonical-url}{.}" hreflang="{$prefix}" />
    </x:for-each>

    <!-- Also add alternate tag for the default lang -->
    <x:if test="@default">
      <link rel="alternate" href="{$canonical-url}" hreflang="{@default}" />
    </x:if>
  </x:template>
</x:transform>